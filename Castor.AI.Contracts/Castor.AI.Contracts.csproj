<Project Sdk="Microsoft.NET.Sdk">

  <!-- Wire contract shared by the client SDK (Castor.AI) and the workers: gRPC messages + shared memory layout. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- NuGet package (published by .github/workflows/nuget.yml on v*.*.* tags). -->
  <PropertyGroup>
    <PackageId>Castor.AI.Contracts</PackageId>
    <Version>0.0.0-dev</Version>
    <Authors>Castor Studio</Authors>
    <Description>Wire contract shared by the Castor.AI client SDK and the AI workers: gRPC messages and shared memory layout.</Description>
    <RepositoryUrl>https://github.com/Castor-Studio/Castor-AI-Worker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Grpc.Core.Api" Version="2.67.0" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\castor_ai.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>
