{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "Castor.AI/Castor.AI.csproj",
            "Castor.AI.Contracts/Castor.AI.Contracts.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "**/*.{md,yml}" ],
        "exclude": [ "_site/**", "docfx.json" ]
      }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "Castor AI",
      "_appTitle": "Castor AI",
      "_appFooter": "Castor AI - Castor Studio",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
