<Project Sdk="Microsoft.NET.Sdk">

  <!-- Debug console for the AI team. All AI communication goes through Castor.AI. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Castor.AI\Castor.AI.csproj" />
    <!-- Build order only: Castor.AI spawns the worker executable, nothing links it. -->
    <ProjectReference Include="..\Castor.AI.Worker\Castor.AI.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
